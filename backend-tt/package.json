{
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:console": "node scripts/test-report.js --print",
    "test:integration": "RUN_INTEGRATION=1 node --test test/integration/*.test.js",
    "test:docker": "RUN_DOCKER=1 node --test test/docker/*.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:docker",
    "test:report": "node scripts/test-report.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.0"
  }
}
